{
  "manifestVersion": 1,
  "id": "vibeguard-orca",
  "publisher": "vibeguard",
  "name": "VibeGuard",
  "version": "0.1.0",
  "description": "Real-time security guard for AI-generated code: local L1/L2/L3 fast screening + LLM semantic review (Claude/Codex/Gemini).",
  "engines": { "orca": ">=1.4.0" },
  "pluginApi": 1,
  "main": "main.mjs",
  "contributes": {
    "panels": [{ "id": "vibeguard", "title": "VibeGuard", "icon": "shield", "entry": "panel.html" }],
    "commands": [
      { "id": "vibeguard.scanFile", "title": "VibeGuard: Scan File", "context": "worktree" },
      { "id": "vibeguard.fix", "title": "VibeGuard: One-Click Fix (send to agent terminal)", "context": "worktree" },
      { "id": "vibeguard.status", "title": "VibeGuard: Status", "context": "global" },
      { "id": "vibeguard.scanAll", "title": "VibeGuard: Scan Whole Project", "context": "global" }
    ],
    "events": [{ "on": "worktree.created" }, { "on": "worktree.removed" }, { "on": "agent.status.changed" }]
  },
  "capabilities": [
    { "kind": "workspace:read" },
    { "kind": "terminal:send" },
    { "kind": "notifications:show" },
    { "kind": "storage" },
    { "kind": "events:subscribe" }
  ]
}
